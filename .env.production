# Same-origin proxy path — browser calls localhost:3000/api/app/v1/* (no CORS).
NEXT_PUBLIC_API_BASE_URL=/api/app/v1

# Backend target for the Next.js API proxy (server-only).
API_BACKEND_URL=https://5b70-2400-9800-3cf-4c35-e988-b236-e922-c0c4.ngrok-free.app/api/app/v1

NEXT_PUBLIC_APP_NAME=SDMS
NEXT_PUBLIC_API_TIMEOUT=30000

# Dev-only mock auth (no backend). Login: admin / password123
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
