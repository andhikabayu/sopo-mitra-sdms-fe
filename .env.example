# Same-origin API path (proxied by Next.js — avoids CORS in the browser).
NEXT_PUBLIC_API_BASE_URL=/api/app/v1

# Real backend URL (server-only). Next.js forwards /api/app/v1/* here.
# Local:  http://localhost:8000/api/app/v1
# Ngrok:  https://YOUR-SUBDOMAIN.ngrok-free.app/api/app/v1
API_BACKEND_URL=http://localhost:8000/api/app/v1

NEXT_PUBLIC_APP_NAME=SDMS
NEXT_PUBLIC_API_TIMEOUT=30000

# Dev-only mock auth (no backend). Login: admin / password123
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
